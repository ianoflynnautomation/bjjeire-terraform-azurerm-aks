{
  "name": "terraform-azurerm-aks",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.15.3",

      "tflint": "0.53.0",
      "terragrunt": "latest",
      "installTerraformDocs": true,
      "installSentinel": false,
      "installTFsec": false
    },

    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest",
      "installBicep": true,
      "extensions": "aks-preview"
    },

    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },

    "ghcr.io/dhoeric/features/k9s:1": {},
    "ghcr.io/dhoeric/features/trivy:1": {},
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {}

    // Optional: uncomment if you ever build/push container images from this repo.
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // Static, non-secret settings baked into the container.
  "containerEnv": {
    // Cache providers across `terraform init` runs and workspaces (big speedup, less bandwidth).
    "TF_PLUGIN_CACHE_DIR": "/home/vscode/.terraform.d/plugin-cache",
    // Default auth path: reuse `az login`. Override by supplying ARM_CLIENT_ID/SECRET below.
    "ARM_USE_AZURECLI_AUTH": "true",
    // Mirrors providers.tf `storage_use_azuread = true` so the azurerm backend uses AAD auth.
    "ARM_STORAGE_USE_AZUREAD": "true",
    // Quieter, faster CLI.
    "CHECKPOINT_DISABLE": "1",
    // Where `az aks get-credentials` writes; backed by the aks-tf-kube volume
    // below so cluster credentials survive a rebuild.
    "KUBECONFIG": "/home/vscode/.kube/config",
    // dev/staging set aks_local_account_disabled = true, so the kubeconfig is
    // Entra-backed and kubectl shells out to kubelogin. This makes kubelogin
    // reuse the `az login` token instead of prompting for a device code, which
    // is the same as running `kubelogin convert-kubeconfig -l azurecli`.
    "AAD_LOGIN_METHOD": "azurecli"
    // Uncomment to debug providers: "TF_LOG": "DEBUG"
  },

  "remoteEnv": {
    "ARM_SUBSCRIPTION_ID": "${localEnv:ARM_SUBSCRIPTION_ID}",
    "ARM_TENANT_ID": "${localEnv:ARM_TENANT_ID}",
    "ARM_CLIENT_ID": "${localEnv:ARM_CLIENT_ID}",
    "ARM_CLIENT_SECRET": "${localEnv:ARM_CLIENT_SECRET}",
    "ARM_ACCESS_KEY": "${localEnv:ARM_ACCESS_KEY}"
  },

  "mounts": [
    "source=aks-tf-azure,target=/home/vscode/.azure,type=volume",
    "source=aks-tf-plugin-cache,target=/home/vscode/.terraform.d/plugin-cache,type=volume",
    "source=aks-tf-tflint,target=/home/vscode/.tflint.d,type=volume",
    "source=aks-tf-kube,target=/home/vscode/.kube,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "hashicorp.hcl",
        "ms-azuretools.vscode-azureterraform",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-vscode.azurecli",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "aquasecurityofficial.trivy-vulnerability-scanner",
        "github.vscode-github-actions"
      ],
      "settings": {
        "terraform.languageServer.enable": true,
        "terraform.validation.enableEnhancedValidation": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "files.associations": {
          "*.tfvars.example": "terraform-vars",
          "*.auto.tfvars.example": "terraform-vars"
        },
        "redhat.telemetry.enabled": false
      }
    }
  }
}
